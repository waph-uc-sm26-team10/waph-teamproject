# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored - never commit it.
#
#   cp .env.example .env
#   # then edit .env with your real passwords
#
# Read by the app via src/config/env.php and by database/setup.sh.
# Use `#` for comments only - this file is also sourced by bash.

# --- MySQL connection (used by the app and by database/setup.sh) ---
DB_HOST=localhost
DB_NAME=waph_team
DB_USER=your_uc_user
DB_PASSWORD=changeme

# --- Initial admin account seeded into the users table ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Optional - setup.sh will fall back to a default if these are omitted.
ADMIN_EMAIL=admin@waph-team10.minifacebook.com
ADMIN_NAME=Team 10 Admin
